		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dotenv": "17.4.2",
		"dsar": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@dsar/typescript-config": "workspace:*",
		"@types/node": "catalog:types"
	}
}
