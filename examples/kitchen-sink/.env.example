# Core runtime
NODE_ENV=development
# PORT is auto-assigned by portless in `pnpm dev`; use this value for direct runs.
PORT=3021
DSAR_BASE_PATH=/api/v1
# Shared local example auth secrets. Reuse these same values in
# `examples/dashboard/.env` and `examples/subject-portal/.env`.
# `DSAR_ADMIN_API_TOKEN` / `DSAR_API_TOKEN` is the supported simple self-hosted
# path. `DSAR_SUBJECT_API_TOKEN` is only for the local subject-portal demo.
DSAR_ADMIN_API_TOKEN=dsar_admin_local_dev_token
DSAR_SUBJECT_API_TOKEN=dsar_subject_local_dev_token
DSAR_DEFAULT_LOCALE=en-GB
DSAR_ENABLE_MANIFEST_REVIEW=true
DSAR_AI_ENABLED=false

# Persistence + local filesystem storage adapter
DSAR_PERSISTENCE_DRIVER=sqlite
DSAR_PERSISTENCE_SQLITE_PATH=.dsar-kitchen-sink.db
# DSAR_PERSISTENCE_PG_URL=postgres://postgres:postgres@localhost:5432/dsar
FS_STORAGE_BASE_DIR=.dsar-kitchen-sink-artifacts
FS_STORAGE_PREFIX=artifacts
FS_STORAGE_RETRY_MAX_ATTEMPTS=1

# Inbound Resend adapter
DSAR_INBOUND_RESEND_WEBHOOK_SECRET=resend_dev_webhook_secret
DSAR_INBOUND_DEFAULT_JURISDICTION=uk
# Optional workspace override for inbound routing:
# DSAR_INBOUND_DEFAULT_WORKSPACE_ID=workspace-default
# Optional Slack inbound settings:
# SLACK_SIGNING_SECRET=slack_dev_signing_secret
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEDUPE_TTL_MS=300000
# Deduplication window in ms; default 300000.
# SLACK_REPLAY_TOLERANCE_SECONDS=300
# Replay tolerance in seconds; default 300.
# SLACK_BOT_USERNAME=dsar-bot

# Outbound Resend notification adapter
DSAR_OUTBOUND_RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
DSAR_OUTBOUND_RESEND_FROM="DSAR Kitchen Sink <no-reply@example.com>"
DSAR_OUTBOUND_RESEND_ENABLED=true
DSAR_OUTBOUND_RESEND_LIVE=true
# Optional outbound adapter knobs:
# DSAR_OUTBOUND_RESEND_REPLY_TO=privacy@example.com
# DSAR_OUTBOUND_RESEND_SUBJECT_PREFIX=[DSAR]
# DSAR_OUTBOUND_RESEND_TIMEOUT_MS=2000
# DSAR_OUTBOUND_RESEND_FALLBACK_RECIPIENT=privacy@example.com

# Kitchen sink runner knobs
DSAR_TEST_TENANT=tenant-default

# Optional hosted-style bearer verification via Unkey.
# UNKEY_ROOT_KEY=unkey_root_...
# DSAR_UNKEY_REQUIRED_PERMISSION=dsar.api
