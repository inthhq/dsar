{
	"name": "dsar-workspace",
	"private": true,
	"description": "Developer-first DSAR engine: APIs, SDK, lifecycle, policy, and webhooks",
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"examples/*",
			"packages/*",
			"packages/internals/*"
		],
		"catalogs": {
			"utils": {
				"typescript": "6.0.3",
				"vitest": "4.0.18",
				"tsdown": "0.20.3",
				"@typescript/native-preview": "7.0.0-dev.20260421.2"
			},
			"effect": {
				"effect": "4.0.0-beta.25",
				"@effect/platform-node": "4.0.0-beta.25",
				"@effect/language-service": "0.77.0",
				"@effect/vitest": "4.0.0-beta.25",
				"@effect/sql-sqlite-bun": "4.0.0-beta.25",
				"@effect/sql-sqlite-node": "4.0.0-beta.25"
			},
			"types": {
				"@types/node": "25.3.0"
			}
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"check": "ultracite check && bun run check:docs-alpha-warning && bun run check:error-docs && bun run check:tsdoc",
		"check:docs-alpha-warning": "bun ./scripts/sync-docs-alpha-warning.ts",
		"check:error-docs": "bun ./scripts/check-error-doc-coverage.ts",
		"check:tsdoc": "bun ./scripts/check-tsdoc-coverage.ts",
		"check:workspace": "turbo run check",
		"check-types": "turbo run typecheck",
		"ci:publish": "bunx changeset tag && bun publish",
		"ci:version": "bun changeset version",
		"dev": "turbo run dev",
		"docs:sync-alpha-warning": "bun ./scripts/sync-docs-alpha-warning.ts --write",
		"dsar": "bun ./packages/dsar/src/bin.ts",
		"fix": "ultracite fix",
		"format": "turbo run format",
		"format:write": "turbo run format -- --write",
		"lint": "turbo run lint",
		"prepare": "lefthook install",
		"release": "bun run build && rm -rf packages/dsar/docs && cp -r docs packages/dsar/docs && changeset publish",
		"release:canary": "bun run build && rm -rf packages/dsar/docs && cp -r docs packages/dsar/docs && changeset publish --tag canary",
		"smoke": "turbo run smoke",
		"start": "turbo run start",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"version": "changeset version && bun install",
		"version:canary": "changeset version --snapshot canary && bun install",
		"version:prerelease": "changeset pre enter canary",
		"version:prerelease:exit": "changeset pre exit"
	},
	"dependencies": {
		"readie": "^1.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"@biomejs/biome": "2.4.4",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@effect/vitest": "4.0.0-beta.25",
		"@typescript/native-preview": "catalog:utils",
		"changeset-conventional-commits": "^0.2.5",
		"lefthook": "2.1.1",
		"oxfmt": "0.36.0",
		"oxlint": "1.51.0",
		"portless": "0.4.2",
		"publint": "^0.3.17",
		"turbo": "2.8.12",
		"typescript": "catalog:utils",
		"ultracite": "7.2.4"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.6",
	"trustedDependencies": [
		"better-sqlite3"
	]
}
