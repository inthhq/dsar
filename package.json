{
	"name": "dsar-workspace",
	"private": true,
	"description": "Developer-first DSAR engine: APIs, SDK, lifecycle, policy, and webhooks",
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"examples/*",
			"packages/*",
			"packages/internals/*"
		],
		"catalogs": {
			"utils": {
				"typescript": "7.0.2",
				"vitest": "4.1.10",
				"tsdown": "0.22.13"
			},
			"effect": {
				"effect": "4.0.0",
				"@effect/platform-node": "4.0.0",
				"@effect/language-service": "0.87.0",
				"@effect/vitest": "4.0.0",
				"@effect/sql-pg": "4.0.0",
				"@effect/sql-sqlite-bun": "4.0.0",
				"@effect/sql-sqlite-node": "4.0.0"
			},
			"types": {
				"@types/node": "24.13.3"
			}
		}
	},
	"type": "module",
	"scripts": {
		"bench": "PERF=1 turbo run bench",
		"build": "turbo run build",
		"check": "ultracite check && bun run check:docs-alpha-warning && bun run check:docs-lint && bun run check:error-docs && bun run check:tsdoc",
		"check-types": "turbo run typecheck",
		"check:docs-alpha-warning": "bun ./scripts/sync-docs-alpha-warning.ts",
		"check:docs-lint": "bunx leadtype lint --src docs --error-unknown",
		"check:error-docs": "bun ./scripts/check-error-doc-coverage.ts",
		"check:publish-artifacts": "bun ./scripts/check-publish-artifacts.ts",
		"check:tsdoc": "bun ./scripts/check-tsdoc-coverage.ts",
		"check:workspace": "turbo run check",
		"dev": "turbo run dev",
		"docs:sync-alpha-warning": "bun ./scripts/sync-docs-alpha-warning.ts --write",
		"dsar": "bun ./packages/dsar/src/bin.ts",
		"fix": "ultracite fix",
		"format": "turbo run format",
		"format:write": "turbo run format -- --write",
		"lint": "turbo run lint",
		"prepare": "lefthook install",
		"prepare:effect": "./scripts/prepare-effect.sh",
		"release": "bun run tegami publish",
		"release:docs": "rm -rf packages/dsar/docs packages/dsar/AGENTS.md packages/dsar/SKILL.md && bunx leadtype generate --bundle --src . --out packages/dsar --name dsar --enrich-git",
		"smoke": "turbo run smoke",
		"start": "turbo run start",
		"tegami": "bun ./scripts/tegami.ts",
		"test": "turbo run test",
		"test:scripts": "vitest run --config scripts/vitest.config.ts",
		"typecheck": "turbo run typecheck",
		"version": "bun run tegami version"
	},
	"dependencies": {
		"readie": "^1.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@biomejs/biome": "2.5.5",
		"@effect/vitest": "catalog:effect",
		"@types/node": "catalog:types",
		"@types/semver": "7.8.0",
		"@typescript/typescript6": "6.0.2",
		"jsonc-parser": "3.3.1",
		"leadtype": "0.4.2",
		"lefthook": "2.1.10",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"portless": "0.15.4",
		"publint": "^0.3.22",
		"semver": "7.8.5",
		"tegami": "1.5.0",
		"turbo": "2.10.6",
		"typescript": "catalog:utils",
		"ultracite": "7.9.4",
		"vitest": "catalog:utils",
		"yaml": "2.9.1"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "bun@1.3.14",
	"patchedDependencies": {
		"leadtype@0.4.2": "patches/leadtype@0.4.2.patch"
	},
	"trustedDependencies": [
		"better-sqlite3"
	]
}
