{
	"name": "dsar",
	"version": "1.0.0",
	"private": false,
	"description": "Data Subject Access Request engine: backend, Node SDK, CLI, React widgets, and adapters in one package.",
	"license": "Apache-2.0",
	"bin": {
		"dsar": "./dist/bin.mjs"
	},
	"files": [
		"dist",
		"docs",
		"AGENTS.md",
		"SKILL.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./backend": {
			"types": "./dist/backend.d.mts",
			"import": "./dist/backend.mjs"
		},
		"./core": {
			"types": "./dist/core.d.mts",
			"import": "./dist/core.mjs"
		},
		"./chat": {
			"types": "./dist/chat.d.mts",
			"import": "./dist/chat.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./node-sdk": {
			"types": "./dist/node-sdk.d.mts",
			"import": "./dist/node-sdk.mjs"
		},
		"./node-sdk/webhooks": {
			"types": "./dist/node-sdk-webhooks.d.mts",
			"import": "./dist/node-sdk-webhooks.mjs"
		},
		"./node-sdk/webhooks/express": {
			"types": "./dist/node-sdk-webhooks-express.d.mts",
			"import": "./dist/node-sdk-webhooks-express.mjs"
		},
		"./node-sdk/webhooks/hono": {
			"types": "./dist/node-sdk-webhooks-hono.d.mts",
			"import": "./dist/node-sdk-webhooks-hono.mjs"
		},
		"./node-sdk/webhooks/next": {
			"types": "./dist/node-sdk-webhooks-next.d.mts",
			"import": "./dist/node-sdk-webhooks-next.mjs"
		},
		"./persistence": {
			"types": "./dist/persistence.d.mts",
			"import": "./dist/persistence.mjs"
		},
		"./persistence-pg": {
			"types": "./dist/persistence-pg.d.mts",
			"import": "./dist/persistence-pg.mjs"
		},
		"./persistence-sqlite": {
			"types": "./dist/persistence-sqlite.d.mts",
			"import": "./dist/persistence-sqlite.mjs"
		},
		"./storage-filesystem": {
			"types": "./dist/storage-filesystem.d.mts",
			"import": "./dist/storage-filesystem.mjs"
		},
		"./storage-s3": {
			"types": "./dist/storage-s3.d.mts",
			"import": "./dist/storage-s3.mjs"
		},
		"./storage-vercel-blob": {
			"types": "./dist/storage-vercel-blob.d.mts",
			"import": "./dist/storage-vercel-blob.mjs"
		},
		"./inbound-resend": {
			"types": "./dist/inbound-resend.d.mts",
			"import": "./dist/inbound-resend.mjs"
		},
		"./inbound-slack": {
			"types": "./dist/inbound-slack.d.mts",
			"import": "./dist/inbound-slack.mjs"
		},
		"./outbound-resend": {
			"types": "./dist/outbound-resend.d.mts",
			"import": "./dist/outbound-resend.mjs"
		},
		"./redis": {
			"types": "./dist/redis.d.mts",
			"import": "./dist/redis.mjs"
		},
		"./upstash": {
			"types": "./dist/upstash.d.mts",
			"import": "./dist/upstash.mjs"
		},
		"./auth-unkey": {
			"types": "./dist/auth-unkey.d.mts",
			"import": "./dist/auth-unkey.mjs"
		},
		"./react": {
			"types": "./dist/react.d.mts",
			"import": "./dist/react.mjs"
		},
		"./react/styles.css": "./dist/react/styles.css"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "^4.0.0",
		"defu": "6.1.7",
		"dotenv": "17.4.2",
		"evlog": "^2.29.0",
		"hono": "^4.13.12"
	},
	"devDependencies": {
		"@dsar/auth-unkey": "workspace:*",
		"@dsar/backend": "workspace:*",
		"@dsar/cli": "workspace:*",
		"@dsar/core": "workspace:*",
		"@dsar/inbound-resend": "workspace:*",
		"@dsar/inbound-slack": "workspace:*",
		"@dsar/node-sdk": "workspace:*",
		"@dsar/outbound-resend": "workspace:*",
		"@dsar/persistence": "workspace:*",
		"@dsar/persistence-pg": "workspace:*",
		"@dsar/persistence-sqlite": "workspace:*",
		"@dsar/react": "workspace:*",
		"@dsar/redis": "workspace:*",
		"@dsar/storage-filesystem": "workspace:*",
		"@dsar/storage-s3": "workspace:*",
		"@dsar/storage-vercel-blob": "workspace:*",
		"@dsar/typescript-config": "workspace:*",
		"@dsar/upstash": "workspace:*",
		"@types/node": "catalog:types",
		"tsdown": "catalog:utils",
		"typescript": "catalog:utils"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.1093.0",
		"@chat-adapter/slack": "^4.34.0",
		"@effect/sql-pg": "^4.0.0",
		"@effect/sql-sqlite-bun": "^4.0.0",
		"@effect/sql-sqlite-node": "^4.0.0",
		"@resend/chat-sdk-adapter": "^0.2.2",
		"@unkey/api": "^2.5.0",
		"@vercel/blob": "^2.6.1",
		"chat": "^4.34.0",
		"effect": "^4.0.0",
		"express": "^4.0.0 || ^5.0.0",
		"next": "^13.4.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
		"react": "^19.0.0",
		"resend": "^6.18.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@chat-adapter/slack": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"@effect/sql-sqlite-bun": {
			"optional": true
		},
		"@effect/sql-sqlite-node": {
			"optional": true
		},
		"@resend/chat-sdk-adapter": {
			"optional": true
		},
		"@unkey/api": {
			"optional": true
		},
		"@vercel/blob": {
			"optional": true
		},
		"chat": {
			"optional": true
		},
		"express": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"resend": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24 <25"
	}
}
