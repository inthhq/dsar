{
	"name": "@dsar/persistence-pg",
	"version": "0.0.5",
	"private": true,
	"description": "Postgres driver package for DSAR persistence.",
	"license": "Apache-2.0",
	"files": [
		"src"
	],
	"type": "module",
	"imports": {
		"#src": "./src/index.ts",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json README.md",
		"lint": "oxlint .",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@dsar/internals-error-codes": "workspace:*",
		"@dsar/persistence": "workspace:*",
		"@effect/sql-pg": "4.0.0-beta.13",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@dsar/typescript-config": "workspace:*",
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"typescript": "catalog:utils",
		"vitest": "catalog:utils"
	}
}
