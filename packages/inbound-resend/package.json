{
	"name": "@dsar/inbound-resend",
	"version": "0.0.5",
	"private": true,
	"description": "Inbound Resend webhook adapter for DSAR request intake.",
	"license": "Apache-2.0",
	"files": [
		"src"
	],
	"type": "module",
	"imports": {
		"#src": "./src/index.ts",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json README.md",
		"lint": "oxlint .",
		"test": "vitest run",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@dsar/backend": "workspace:*",
		"@dsar/core": "workspace:*",
		"@dsar/guards": "workspace:*",
		"@dsar/internals-error-codes": "workspace:*",
		"@resend/chat-sdk-adapter": "0.1.0",
		"chat": "4.18.0",
		"effect": "catalog:effect",
		"resend": "6.9.2"
	},
	"devDependencies": {
		"@dsar/typescript-config": "workspace:*",
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"typescript": "catalog:utils",
		"vitest": "catalog:utils"
	}
}
