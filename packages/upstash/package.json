{
	"name": "@dsar/upstash",
	"version": "0.0.5",
	"private": true,
	"description": "Optional Upstash integrations for DSAR runtimes.",
	"license": "Apache-2.0",
	"files": [
		"src"
	],
	"type": "module",
	"imports": {
		"#src": "./src/index.ts",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json README.md",
		"lint": "oxlint .",
		"test": "vitest run",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@dsar/backend": "workspace:*"
	},
	"devDependencies": {
		"@dsar/typescript-config": "workspace:*",
		"@effect/vitest": "catalog:effect",
		"@typescript/native-preview": "catalog:utils",
		"typescript": "catalog:utils",
		"vitest": "catalog:utils"
	},
	"peerDependencies": {
		"@upstash/redis": "^1.35.3"
	}
}
