    "/requests/{id}/clock/explain": {
      "get": {
        "operationId": "requests_clock_explain",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
