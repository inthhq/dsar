{
	"name": "@dsar/cli",
	"version": "0.0.5",
	"private": true,
	"description": "Command-line interface for DSAR APIs.",
	"license": "Apache-2.0",
	"files": [
		"src"
	],
	"type": "module",
	"imports": {
		"#src": "./src/index.ts",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json README.md",
		"lint": "oxlint .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dsar/guards": "workspace:*",
		"@dsar/internals-error-codes": "workspace:*",
		"@dsar/node-sdk": "workspace:*",
		"@dsar/schema": "workspace:*",
		"@effect/platform-node": "catalog:effect",
		"dotenv": "17.4.2",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@dsar/backend": "workspace:*",
		"@dsar/typescript-config": "workspace:*",
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@types/node": "catalog:types",
		"typescript": "catalog:utils",
		"vitest": "catalog:utils"
	}
}
