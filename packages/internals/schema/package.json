{
	"name": "@dsar/schema",
	"version": "0.0.5",
	"private": true,
	"description": "Canonical DSAR domain model and runtime contracts.",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
