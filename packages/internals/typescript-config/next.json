{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Next.js",
	"extends": "./base.json",
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "esnext"],
		"allowJs": true,
		"noEmit": true,
		"noUncheckedSideEffectImports": false,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"${configDir}/next-env.d.ts",
		"${configDir}/**/*.ts",
		"${configDir}/**/*.tsx",
		"${configDir}/.next/types/**/*.ts",
		"${configDir}/.next/dev/types/**/*.ts",
		"${configDir}/**/*.mts"
	],
	"exclude": ["${configDir}/node_modules"]
}
