{
	"name": "@dsar/persistence",
	"version": "0.0.5",
	"private": true,
	"description": "Tenant-safe persistence layer for DSAR runtime services.",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json tsdown.config.ts README.md",
		"lint": "oxlint .",
