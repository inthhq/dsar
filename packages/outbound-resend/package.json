{
	"name": "@dsar/outbound-resend",
	"version": "0.0.5",
	"private": true,
	"description": "Resend notification email adapter for DSAR runtime events.",
	"license": "Apache-2.0",
	"files": [
		"src"
	],
	"type": "module",
	"imports": {
		"#src": "./src/index.ts",
		"#src/chat": "./src/chat-entry.ts",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./chat": {
			"types": "./src/chat-entry.ts",
			"import": "./src/chat-entry.ts"
		}
	},
	"scripts": {
		"format": "oxfmt --check src test package.json tsconfig.json README.md",
		"lint": "oxlint .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dsar/backend": "workspace:*",
		"@dsar/core": "workspace:*",
		"@dsar/guards": "workspace:*",
		"@dsar/internals-error-codes": "workspace:*",
		"@resend/chat-sdk-adapter": "^0.2.2",
		"chat": "^4.34.0",
		"effect": "catalog:effect",
		"resend": "6.18.0"
	},
	"devDependencies": {
		"@dsar/typescript-config": "workspace:*",
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"typescript": "catalog:utils",
		"vitest": "catalog:utils"
	}
}
